# Application
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=900       # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRES=604800   # 7 days in seconds

# Database
DATABASE_URL=postgresql://hms_user:hms_password@postgres:5432/hms_db
POSTGRES_DB=hms_db
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=hms_password

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760   # 10 MB in bytes
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Rate Limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URL=redis://redis:6379/3

# Frontend URL (for password reset emails etc.)
FRONTEND_URL=http://localhost:5173

# Real Email Delivery (SMTP e.g. Gmail, Outlook, SendGrid)
# For Gmail: Use an App Password from your Google Account (Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=True

# Real SMS Delivery (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

